# 本地开发配置。复制为 .env.local；不要提交包含真实密码的 .env.local。
# scripts/setup-local-db.ps1 可以创建本地数据库并自动生成该文件。
MES_DB_HOST=127.0.0.1
MES_DB_PORT=5432
MES_DB_NAME=MES
MES_DB_USER=mes_app
MES_DB_PASSWORD=replace_with_local_password

MES_PUBLIC_URL=http://127.0.0.1:8080
MES_TRACE_STORAGE=storage/trace

AI_PLANNING_ENABLED=false
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-turbo
DASHSCOPE_API_KEY=
